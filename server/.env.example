# Copiar este archivo a .env y completar con tus datos de Oracle.
# No subir .env al repositorio.

# Oracle - base gestorParqueo
ORACLE_USER=PARQUEO
ORACLE_PASSWORD=tu_password

# Cadena de conexión. Usar el SID o Servicio real (ej. ORCL), no el nombre de la conexión del cliente.
ORACLE_CONNECT_STRING=localhost:1521/ORCL


