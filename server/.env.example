# Copiar este archivo a .env y completar con tus datos de Oracle.
# No subir .env al repositorio.

# Oracle - gestorParqueo (ajustar según tu instalación)
ORACLE_USER=PARQUEO
ORACLE_PASSWORD=tu_password
ORACLE_CONNECT_STRING=localhost:PUERTO/SID

# Ejemplo con usuario GESTOR_PARQUEO y Oracle XE (puerto 1521, servicio ORCL):
# ORACLE_USER=GESTOR_PARQUEO
# ORACLE_PASSWORD=1234
# ORACLE_CONNECT_STRING=localhost:1521/ORCL


