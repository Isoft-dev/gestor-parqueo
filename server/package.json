{
  "name": "gestor-parqueo-api",
  "version": "1.0.0",
  "description": "Backend del gestor de parqueo (DB y CRUD por implementar)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "dev:seed": "node scripts/run-seed-catalogo-funcional.mjs && node --watch index.js",
    "dev:watch": "node --watch index.js",
    "db:bootstrap": "node scripts/run-bootstrap-db.mjs",
    "db:run-sql": "node scripts/run-sql-file.mjs",
    "db:reinstall-procedures": "node scripts/reinstall-procedures.mjs",
    "db:seed-catalogo-funcional": "node scripts/run-seed-catalogo-funcional.mjs",
    "db:seed-tickets-reporte": "node scripts/run-sql-file.mjs ../database/seed_tickets_reporte_anual.sql",
    "db:seed-membresias-reporte": "node scripts/run-sql-file.mjs ../database/seed_membresias_reporte_anual.sql",
    "db:seed-operativos-reporte": "node scripts/run-sql-file.mjs ../database/seed_operativos_reporte_anual.sql",
    "db:seed-reportes-demo": "node scripts/run-seed-catalogo-funcional.mjs && node scripts/run-sql-file.mjs ../database/seed_tickets_reporte_anual.sql && node scripts/run-sql-file.mjs ../database/seed_membresias_reporte_anual.sql && node scripts/run-sql-file.mjs ../database/seed_operativos_reporte_anual.sql",
    "db:fix-identity-counters": "node scripts/run-fix-identity-counters.mjs",
    "db:fix-ticket-status-from-exit-log": "node scripts/run-fix-ticket-status-from-exit-log.mjs",
    "db:backfill-ticket-nit-clients": "node scripts/run-backfill-ticket-nit-clients.mjs",
    "db:reset-capacity": "node scripts/reset-demo-capacity.mjs",
    "db:verify-schema": "node scripts/verify-schema-par.mjs",
    "jobs:membership:run-now": "node scripts/run-membership-jobs-now.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.4",
    "oracledb": "^6.10.0",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4"
  }
}
