# Configuracion de pnpm para este proyecto.

# node-linker=hoisted: genera un node_modules plano y SIN enlaces simbolicos,
# igual al layout que producia npm. Necesario para que OneDrive no tenga
# problemas con symlinks. Ademas evita que la migracion rompa el build por
# "dependencias fantasma".
node-linker=hoisted

# package-import-method=copy: copia los paquetes desde el store en lugar de
# enlazarlos con hardlinks. Cero problemas de enlaces con OneDrive.
package-import-method=copy
